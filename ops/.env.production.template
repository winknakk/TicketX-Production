# ── AX-INFRA-005: AutomationX V3 Production Environment Template ──
# Copy this file to .env.production and fill in real values.

NODE_ENV=production
PORT=3000

# ── Database ──
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://ax_admin:secure_pass@pg-primary:5432/automationx
DATABASE_REPLICA_URL=postgresql://ax_admin:secure_pass@pg-primary:5432/automationx

# ── Redis (Cache + Queue + Takeover Leases) ──
REDIS_URL=redis://redis:6379/0
QUEUE_PROVIDER=redis

# ── Security ──
API_KEY=CHANGE_ME_TO_REAL_API_KEY
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHAR_SESSION_SECRET
WEBHOOK_SECRET=CHANGE_ME_TO_REAL_WEBHOOK_SECRET

# ── LLM / AI ──
GEMINI_API_KEY=CHANGE_ME_TO_REAL_GEMINI_KEY

# ── MCP ──
PROMPTX_MCP_URL=http://localhost:3001
PROMPTX_MCP_TOKEN=CHANGE_ME_TO_REAL_MCP_TOKEN

# ── External Integrations ──
PLANE_API_URL=https://api.plane.so
PLANE_API_KEY=CHANGE_ME_TO_REAL_PLANE_KEY

# ── Operator Settings ──
HUMAN_SESSION_TIMEOUT_MINUTES=30

# ── LINE Channel ──
LINE_CHANNEL_SECRET=CHANGE_ME
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME
